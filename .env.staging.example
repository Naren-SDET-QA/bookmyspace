# BookMySpace STAGING Environment Template
# Copy to .env.staging for staging builds. Never commit real keys!

APP_ENV=staging
SUPABASE_URL=https://staging-project-ref.supabase.co
SUPABASE_ANON_KEY=staging_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=staging_service_role_key_here
SUPABASE_DB_PASSWORD=staging_db_password_here

RAZORPAY_KEY_ID=rzp_test_staging_key_id
RAZORPAY_KEY_SECRET=rzp_test_staging_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_staging_webhook

GOOGLE_MAPS_ANDROID_API_KEY=staging_google_maps_key
GOOGLE_MAPS_IOS_API_KEY=staging_google_maps_key
