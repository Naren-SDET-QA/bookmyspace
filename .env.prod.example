# BookMySpace PROD Environment Template
# Copy to .env.prod for production releases. Never commit real keys!

APP_ENV=production
SUPABASE_URL=https://prod-project-ref.supabase.co
SUPABASE_ANON_KEY=prod_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=prod_service_role_key_here
SUPABASE_DB_PASSWORD=prod_db_password_here

RAZORPAY_KEY_ID=rzp_live_prod_key_id
RAZORPAY_KEY_SECRET=rzp_live_prod_secret
RAZORPAY_WEBHOOK_SECRET=rzp_live_prod_webhook

GOOGLE_MAPS_ANDROID_API_KEY=prod_google_maps_key
GOOGLE_MAPS_IOS_API_KEY=prod_google_maps_key
