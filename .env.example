# =============================================================
# BookMySpace — Environment Configuration (placeholders only)
# -------------------------------------------------------------
# NEVER commit real secrets. Copy this file and fill in values
# for your own environments.
# =============================================================

# --- Flutter build-time defines (pass via --dart-define) ---
# Example:
#   flutter run --dart-define=APP_ENV=staging \
#     --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
APP_ENV=development

# --- Supabase ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD_HERE

# --- Razorpay (test keys for sandbox, live keys only for production) ---
RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER
RAZORPAY_KEY_SECRET=rzp_test_PLACEHOLDER_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# --- Firebase (from Firebase console) ---
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID

# --- Google Maps (restricted key with platform limits) ---
GOOGLE_MAPS_ANDROID_API_KEY=YOUR_ANDROID_RESTRICTED_KEY
GOOGLE_MAPS_IOS_API_KEY=YOUR_IOS_RESTRICTED_KEY

# --- App Info ---
APP_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_LONG
