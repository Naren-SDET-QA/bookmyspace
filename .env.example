# =============================================================
# BookMySpace — Environment Configuration (placeholders only)
# -------------------------------------------------------------
# NEVER commit real secrets. Copy to `.env` and fill in values
# for your own environments.
# =============================================================

# --- Flutter build-time defines ---
# Option A — load from .env via helper script:
#   Windows:  .\scripts\flutter_run.ps1
#   macOS/Linux: ./scripts/flutter_run.sh
# Option B — pass manually:
#   flutter run --dart-define=APP_ENV=development \
#     --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
APP_ENV=development

# --- Supabase ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD_HERE

# --- Razorpay (test keys for sandbox, live keys only for production) ---
# Flutter: pass RAZORPAY_KEY_ID via --dart-define (public key id only).
# Supabase Edge Functions: set RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET,
# and RAZORPAY_WEBHOOK_SECRET as project secrets (never in the app).
RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER
RAZORPAY_KEY_SECRET=rzp_test_PLACEHOLDER_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# --- Firebase (from Firebase console) ---
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID

# --- Google Maps / Places (optional; OSM used by default for venue import) ---
GOOGLE_MAPS_ANDROID_API_KEY=YOUR_ANDROID_RESTRICTED_KEY
GOOGLE_MAPS_IOS_API_KEY=YOUR_IOS_RESTRICTED_KEY
# Server-side only (Supabase Edge Function `import-venues`); never in Flutter client.
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY

# --- Dev test login (optional; development environment only) ---
DEV_CUSTOMER_EMAIL=
DEV_CUSTOMER_PASSWORD=
DEV_OWNER_EMAIL=
DEV_OWNER_PASSWORD=
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

# --- Edge Function secrets (set via `supabase secrets set`; reference only) ---
# Used by: create-payment-order, create-refund, razorpay-webhook, dispatch-notifications
RESEND_API_KEY=YOUR_RESEND_API_KEY
TRANSACTIONAL_EMAIL_FROM=BookMySpace <noreply@YOUR_DOMAIN>
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_TEMPLATE_NAME=YOUR_WHATSAPP_TEMPLATE_NAME
WHATSAPP_TEMPLATE_LANGUAGE=en
NOTIFICATION_CRON_SECRET=YOUR_NOTIFICATION_CRON_SECRET

# --- App Info ---
APP_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_LONG
